# Copy to .env locally (never commit .env).
# On Render: set variables in the dashboard Environment tab only.

PORT=5000
NODE_ENV=production

# Required: paste your real URI only in .env or Render — not in this file.
# In Atlas: Cluster → Connect → Drivers → copy string. Replace <password> with your DB user password.
# Format (example only — do not put credentials on this line in git):
#   mongodb+srv://DB_USER:DB_PASSWORD@CLUSTER_HOST/DATABASE_NAME?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=
JWT_EXPIRE=7d
