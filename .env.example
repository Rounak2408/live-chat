# Copy to .env locally. On Render, set these in Environment (not from this file).

PORT=5000
NODE_ENV=production

# Required — MongoDB Atlas: Cluster → Connect → Drivers → copy connection string
# Replace <password> and use a database name at the end, e.g. ...mongodb.net/live_chat
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/live_chat?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=7d
